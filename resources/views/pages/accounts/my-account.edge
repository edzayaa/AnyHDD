<!-- EDIT ACCOUNT DRAWER -->
<div id="edit-account-drawer-container">
    <div id="edit-account-overlay"></div>

    <aside id="edit-account-drawer" x-data="editAccountDrawer({
            firstName: '{{ customer.firstName ?? '' }}',
            lastName: '{{ customer.lastName ?? '' }}',
            email: '{{ customer.email }}',
            phone: '{{ customer.phone ?? '' }}'
        })" @close:modal="$refs.cancelButton.click()">
        <div class="drawer-header">
            <svg class="close-btn-account-edit" width="8" height="14" viewBox="0 0 8 14" fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M7 13L1 7L7 1" stroke="#052F5A" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" />
            </svg>
            <h2 class="s">Edit your details</h2>
        </div>

        <div id="response-feedback"></div>

        <div class="drawer-content">
            <form id="edit-account-form" 
                x-ref="editAccountForm" 
                hx-post="{{ route('api.customer.updateCustomer') }}"
                hx-target="#personal-info-section" 
                hx-target-error="#response-feedback"
                hx-swap="innerHTML"
                @htmx:before-request="loading = true"
                @htmx:after-request="loading = false">
                <div class="divided-input">
                    <div class="form-group">
                        <label class="form-label" for="edit-first-name">First Name</label>
                        <input type="text" id="edit-first-name" class="form-input" name="firstName"
                            x-model="form.firstName">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="edit-last-name">Last Name</label>
                        <input type="text" id="edit-last-name" class="form-input" name="lastName"
                            x-model="form.lastName">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-email">Email</label>
                    <input type="email" id="edit-email" class="form-input" name="email" x-model="form.email">
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-phone">Phone Number</label>
                    <input type="tel" id="edit-phone" class="form-input" name="phone" x-model="form.phone">
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-password">Password</label>
                    <input type="password" id="edit-password" class="form-input" name="password" x-model="form.password"
                        placeholder="Enter new password">
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-confirm-password">Confirm Password</label>
                    <input type="password" id="edit-confirm-password" class="form-input" name="confirmPassword"
                        x-model="form.confirmPassword" placeholder="Confirm new password">
                </div>
            </form>
        </div>

        <div class="drawer-footer">
            <button type="submit" form="edit-account-form" id="save-account-btn" class="btn-save htmx-button"
                :disabled="loading || !hasChanges" :class="{ 'opacity-50 cursor-not-allowed': loading || !hasChanges }">
                <span :style="{ color: loading ? 'transparent' : ''}">Submit</span>
                <span x-show="loading" class="btn-loader" aria-hidden="true"></span>
            </button>

            <button type="button" class="btn-cancel" id="cancel-edit-btn" x-ref="cancelButton">
                Cancel
            </button>
        </div>
    </aside>
</div>

<div id="smooth-wrapper">
    <div id="smooth-content">
        <div class="contact-us-container">
            <div class="top-spacing"></div>

