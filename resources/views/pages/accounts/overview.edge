@layout.app({title: 'Overview', customClass: 'inner-pages'})

@slot('styles')
@vite(['resources/css/core/accounts/overview.scss', 'resources/js/core/accounts/overview.js'])
@endslot

@slot('main')
<div id="smooth-wrapper">
    <div id="smooth-content">
        <div class="contact-us-container">
            <div class="top-spacing"></div>

