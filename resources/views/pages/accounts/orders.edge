                    @include('components/accounts/sidebar')

                    <!-- Content Area -->
                    <div class="my-account-content show-in-right">
                        <div class="orders-section">
                            <div class="wrapper-scroll">
                                <!-- Order 1 -->
                                @if(customer.orders && customer.orders.edges.length > 0) 
                                @each(order in customer.orders.edges)
                                <div>
                                    <h3 class="order-header-title">Order number <span>#{{ order.node.orderNumber }}</span></h3>
                                    <div class="order-card">
                                        <div class="order-details-grid">
                                            <div class="detail-item">
                                                <span class="label">Order Date</span>
                                                <span class="value">{{ formatOrderDate(order.node.processedAt) }}</span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="label">Total</span>
                                                <span class="value">{{ order.node.totalPrice.amount }} {{ order.node.totalPrice.currencyCode }}</span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="label">Status</span>
                                                <span class="value">{{ formatOrderStatus(order.node.fulfillmentStatus) }}</span>
                                            </div>
                                        </div>
                                        <div class="order-product-row">
                                            @each(item in order.node.lineItems.edges)
                                            <div class="product-info">
                                                <img src="{{ item.node.variant.image.url }}"
                                                    alt="{{ item.node.title }}"
                                                    onerror="this.src='/src/assets/docking-stations.svg'">
                                                <div class="nav-text">
                                                    <h4>{{ item.node.title }}</h4>
                                                    <p>x{{ item.node.quantity }}</p>
                                                </div>
                                            </div>
                                            @endeach
                                            <a href="{{ order.node.statusUrl }}" class="view-order-link">View
                                                Order</a>
                                        </div>
                                    </div>
                                </div>
                                @endeach
                                @else
                                <div class="no-orders-message">
                                    <div class="tw-bg-blue-50 tw-border tw-border-blue-200 tw-text-sm tw-text-blue-800 tw-rounded-lg tw-p-4 dark:tw-bg-blue-800/10 dark:tw-border-blue-900 dark:tw-text-blue-500" role="alert">
