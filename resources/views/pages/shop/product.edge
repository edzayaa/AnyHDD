@layout.app({title: `${ product.title } - AnyHDD`, customClass: 'inner-pages'})

@slot('styles')
@vite(['resources/css/core/shop/product.scss', 'resources/css/app.css', 'resources/js/core/shop/product.js'])
@endslot

@slot('main')
@include('components/feedback/_response_toast')
<div id="smooth-wrapper">
    <div id="smooth-content">
        <div class="product-container-major">
            <div class="top-spacing"></div>

            <!-- START HERE -->
            <section class="main-product-container">
                <div class="thumbnail-carousel">
                    <div class="product-slider-container">
                        <div class="swiper gallery-main">
                            <div class="swiper-wrapper">
                                @each(item in product.images.edges)
                                <div class="swiper-slide product-slide">
                                    <img src="{{ item.node.url }}" class="product-img" />
                                </div>
                                @endeach
                            </div>
                            <div class="swiper-button-next custom-next">
                                <img src="/img/next-arrow.svg" alt="Next" />
                            </div>
                            <div class="swiper-button-prev custom-prev">
                                <img src="/img/prev-arrow.svg" alt="Previous" />
                            </div>
                        </div>

                        <div class="swiper gallery-thumbs">
                            <div class="swiper-wrapper">
                                @each(item in product.images.edges)
                                <div class="swiper-slide product-slide-thumb">
                                    <img src="{{ item.node.url }}" class="product-img-thumb" />
                                </div>
                                @endeach
                            </div>
                        </div>
                    </div>
                </div>
                <div class="product-info" x-data="cartManager">
                    <h1 class="xl product-header fade-in-element">{{ product.title }}</h1>
                    <p class="description-text xs fade-in-element">{{{ product.descriptionHtml }}}</p>
                    <div class="price_box_add_btn">
                        <div class="prices">
                            @if(comparePrices(product.compareAtPriceRange?.minVariantPrice.amount || 0, product.compareAtPriceRange?.maxVariantPrice.amount || 0)) 
                            <p><span> ${{ product.compareAtPriceRange?.maxVariantPrice.amount }} </span> ${{ product.compareAtPriceRange?.minVariantPrice.amount }}</p>
                            @else
                            <p>$ {{ product.compareAtPriceRange?.minVariantPrice.amount }}</p>
                            @endif
                        </div>
                        <div class="add_btn_container">
                            <div class="add_btn">
                                <button @click="$store.product.quantity > 1 && $store.product.quantity--">-</button>
                                <span x-text="$store.product.quantity"></span>
                                <button @click="$store.product.quantity < 20 && $store.product.quantity++">+</button>
                            </div>
                            <Button class='custom-button common-styles' id="add-to-cart-button"  @click="addToCart('{{ product.selectedOrFirstAvailableVariant.id}}')" :disabled="loading">
                                Add to Cart
                                <svg viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect rx="18.5" fill="white"></rect>
                                    <path
                                        d="M25.9179 18.9179C26.1488 18.6871 26.1488 18.3129 25.9179 18.0821L22.1565 14.3206C21.9257 14.0898 21.5514 14.0898 21.3206 14.3206C21.0898 14.5514 21.0898 14.9257 21.3206 15.1565L24.6641 18.5L21.3206 21.8435C21.0898 22.0743 21.0898 22.4486 21.3206 22.6794C21.5514 22.9102 21.9257 22.9102 22.1565 22.6794L25.9179 18.9179ZM11.5 18.5L11.5 19.0911L25.5 19.0911L25.5 18.5L25.5 17.9089L11.5 17.9089L11.5 18.5Z"
                                        fill="#2F80ED"></path>
                                </svg>
                            </Button>
                        </div>
                        @if(product.variants.edges.length > 1) 
                        <p class="description-text xs model-title">
                            Model Condition
                        </p>
                        <div class="btn-model-select-container">
                            @each((item, index) in product.variants.edges)
                            <button @click="variantId = '{{ item.node.id }}'" class="condition-btn {{ index === 0 ? 'active' : '' }}">{{ item.node.title }}</button>
                            @end
                        </div>
                        @end
                        <div class="accordion-section">
                            <div class="accordion js-accordion">
                                <div class="accordion__header">
                                    <h4 class="accordeon-header-title">About {{ product.title }}</h4>
                                    <svg viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12.7676 3V22.525" class="hide-open" stroke="#052F5A"
                                            stroke-width="5.53778" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M3 12.7617H22.525" stroke="#052F5A" stroke-width="5.53778"
                                            stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>

                                </div>
                                <div class="accordion__body">
                                    <div class="radial_gradient_divider"></div>
                                    <p class="xs">
                                        {{ product.customFields?.about || 'No additional information available.' }}
                                    </p>
                                </div>
                            </div>

                            <div class="accordion-wrapper">
                                <div class="accordion js-accordion">
                                    <div class="accordion__header">
                                        <h4 class="accordeon-header-title">Do the products come with a warranty?</h4>
                                        <svg viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12.7676 3V22.525" class="hide-open" stroke="#052F5A"
                                                stroke-width="5.53778" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M3 12.7617H22.525" stroke="#052F5A" stroke-width="5.53778"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>

                                    </div>
                                    <div class="accordion__body">
                                        <div class="radial_gradient_divider"></div>
                                        <p class="xs">
                                            Yes, all our products include an official warranty. The coverage period
                                            varies by product, but typically ranges from 12 to 24 months against
                                            manufacturing defects.
                                        </p>
                                    </div>
                                </div>

                                <div class="accordion js-accordion">
                                    <div class="accordion__header">
                                        <h4 class="accordeon-header-title">Methods of use of the product</h4>
                                        <svg viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12.7676 3V22.525" class="hide-open" stroke="#052F5A"
                                                stroke-width="5.53778" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M3 12.7617H22.525" stroke="#052F5A" stroke-width="5.53778"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>

                                    </div>
                                    <div class="accordion__body">
                                        <div class="radial_gradient_divider"></div>
                                        <p class="xs">
                                            {{ product.customFields?.methods_of_use || 'No usage instructions available.' }}
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <section class="video-section">
                <img class="left-box" alt="video-section-left-image"
                    src="/assets/product/video-section/left-image.webp"></img>
                <div class="video">
                    <img class="thumbnail" src="/assets/product/video-section/thumbnail.webp" alt="">
                    <img src="/assets/product/video-section/play-icon.webp" alt="play-btn" role="button"
