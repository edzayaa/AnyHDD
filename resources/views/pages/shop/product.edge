                            alt="video-section-right-image">
                    </div>
                </div>
            </section>

            @if(product.customFields.package_items && product.customFields.package_items.references && product.customFields.package_items.references.length > 0) 
            <section class="flip-section">
                <h2 class="xxl fade-in-top"><span>What’s</span> Included in<br class="show-mobile" /> the package</h2>
                <div class="wrapper">
                    @each(item in product.customFields.package_items.references)
                    <div class="card">
                        <div class="faces">
                            <div class="face front"><img class="flip-product-image"
                                    src="{{ item.image_data.image.url }}" alt="{{ item.image_data.image.altText || '' }}" /></div>
                            <div class="face back">
                                <span class="card-badge">
                                    <h6>{{ item.tag }}</h6>
                                </span>
                                <h5 class="card-product m">{{ item.title }}</h5>
                                <p class="card-text">{{ item.description }}</p>
                            </div>
                        </div>
                    </div>
                    @endeach
                </div>

