                        </div>
                        <div class="feature-item">
                            <div class="icon-item">
                                <img src="/assets/product/feature-design/bg-item.webp" alt="video resolution icon">
                                <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd"
                                        d="M12.5417 3.79167C7.70918 3.79167 3.79167 7.70918 3.79167 12.5417C3.79167 17.3742 7.70918 21.2917 12.5417 21.2917C17.3742 21.2917 21.2917 17.3742 21.2917 12.5417C21.2917 7.70918 17.3742 3.79167 12.5417 3.79167ZM0.875 12.5417C0.875 6.09835 6.09835 0.875 12.5417 0.875C18.985 0.875 24.2083 6.09835 24.2083 12.5417C24.2083 15.2377 23.2938 17.7202 21.7581 19.6957L26.6978 24.6355C27.2674 25.205 27.2674 26.1283 26.6978 26.6978C26.1283 27.2674 25.205 27.2674 24.6355 26.6978L19.6957 21.7581C17.7202 23.2938 15.2377 24.2083 12.5417 24.2083C6.09835 24.2083 0.875 18.985 0.875 12.5417Z" />
                                </svg>

                            </div>
                            <p class="item-title">Interfaces</p>
                            <p class="item-subtitle">2x DisplayPort</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="warning-dual">
                <div class="who_we_text">
                    <div class="header_cont">
                        <!-- <p class="label-header parragraph_desk">Powering Connections</p> -->
                        <h2 class="section-header xxxl fade-in-left">
                            Warning: <span> {{ product.title }}</span>
                        </h2>
                    </div>
                    <div class="description_cont fade-in-right">
                        <p class="xxxs">{{ product.customFields.warning || '' }}</p>
                        <button onclick="window.location.href='{{ route('termsAndConditions') }}'"
                            class="custom-button common-styles search-button">
                            Terms and conditions
                            <svg width="38" height="37" viewBox="0 0 38 37" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <rect x="0.5" width="37" height="37" rx="18.5" fill="white" />
                                <path
                                    d="M26.4179 18.9179C26.6488 18.6871 26.6488 18.3129 26.4179 18.0821L22.6565 14.3206C22.4257 14.0898 22.0514 14.0898 21.8206 14.3206C21.5898 14.5514 21.5898 14.9257 21.8206 15.1565L25.1641 18.5L21.8206 21.8435C21.5898 22.0743 21.5898 22.4486 21.8206 22.6794C22.0514 22.9102 22.4257 22.9102 22.6565 22.6794L26.4179 18.9179ZM12 18.5L12 19.0911L26 19.0911L26 18.5L26 17.9089L12 17.9089L12 18.5Z"
                                    fill="#2F80ED" />
                            </svg>

                        </button>
                    </div>
                </div>
                @if(product.customFields.product_benefits && product.customFields.product_benefits.references.length > 0) 
                <div class="white-cards-container">
                    @each((item, index) in product.customFields.product_benefits.references)
                    <div class="white-card card-{{ index + 1 }}">
                        <div class="badge-feature-benefits">
                            <h6>{{ item.tag }}</h6>
                        </div>
                        <h5>{{ item.title }}</h5>
                        <p>{{ item.description }}</p>
                        <img class="hide-image" src="{{ item.image_data.image.url }}" alt="benefit image">
                    </div>
                    @endeach
                </div>
                @endif

            </section>

            <section class="product-review">
                @include('components/shop/_reviews')
            </section>
            <!-- END HERE -->
            @include('components/common/footer')
        </div>
    </div>
</div>
@endslot
@end