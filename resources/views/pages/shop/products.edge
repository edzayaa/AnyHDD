                            <img src="/src/assets/after-pay.webp" alt="AfterPay" />
                            <img src="/src/assets/shopify-pay.webp" alt="Shopify Pay" />
                            <img src="/src/assets/klarna.webp" alt="Klarna" />
                        </li>
                    </ul>
