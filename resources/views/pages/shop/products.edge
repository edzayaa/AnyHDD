</div>

<script>
    // Clear all filters function
    function clearFilters() {
        const form = document.getElementById('shop-filters-form');
        const sortSelect = document.getElementById('shop-sort-select');
        
        // Reset all radio buttons and checkboxes
        form.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(input => {
            input.checked = false;
        });
        
        // Reset sort select
        sortSelect.value = '';
        
        // Trigger HTMX request to reload products without filters
        htmx.trigger(form, 'change');
    }

    // Include sort select in form submission
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('shop-filters-form');
        const sortSelect = document.getElementById('shop-sort-select');
        
        // Add hidden input for sortKey when sort changes
        sortSelect.addEventListener('change', function() {
            let sortInput = form.querySelector('input[name="sortKey"]');
            if (!sortInput) {
                sortInput = document.createElement('input');
                sortInput.type = 'hidden';
                sortInput.name = 'sortKey';
                form.appendChild(sortInput);
            }
            sortInput.value = this.value;
            htmx.trigger(form, 'change');
        });
        
        // Before HTMX request, ensure sortKey is included
        document.body.addEventListener('htmx:configRequest', function(evt) {
            if (evt.detail.elt === form || evt.detail.elt.closest('#shop-filters-form')) {
                if (sortSelect.value) {
                    evt.detail.parameters['sortKey'] = sortSelect.value;
                }
            }
        });
    });
</script>
@endslot
