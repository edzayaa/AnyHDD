@layout.app({title: 'Shop', customClass: 'inner-pages'})

@slot('styles')
@vite(['resources/css/core/shop.scss', 'resources/js/core/shop.js'])
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
@endslot

@slot('main')
<div id="smooth-wrapper">
    <div id="smooth-content">
        <div class="products-container shop-page">
            <div class="top-spacing"></div>
            <h1 class="xxxl shop-header fade-in-element"><span>Explore </span>our<br class="show-mobile" /> Docking
                Stations</h1>
            <p class="xxxs shop-subtitle hide-mobile fade-in-reverse">Maximize your workspace with our top-performing
                docking stations, engineered for speed, stability, and seamless connectivity. These customer favorites
                deliver everything you need — from ultra-fast data transfer to multi-device support — all in one sleek,
                reliable hub.</p>
            <p class="shop-subtitle show-mobile  xxxs fade-in-reverse">Maximize your workspace with our top-performing
                docking stations, engineered for speed, stability, and seamless connectivity. </p>

            <p class="shop-subtitle show-mobile xxxs">These customer favorites deliver everything you need — from
                ultra-fast data transfer to multi-device support — all in one sleek, reliable hub.</p>
            <section class="shop-section">
                <div class="blured-circle-1 blured-circle desktop-only"></div>
                <div class="blured-circle-2 blured-circle desktop-only"></div>
                <div class="headers">
                    <div class="top-title">
                        <h2>
                            <img src="/src/assets/product/blue-strip.webp" alt="line" class="blue-strip">
                            Best sellers
                        </h2>
                        <div class="slider-controls">
                            <button class="best-sellers-slider-prev">
                                <img src="/img/prev-arrow.svg" alt="" />
                            </button>
                            <button class="best-sellers-slider-next">
                                <img src="/img/next-arrow.svg" alt="" />
                            </button>
                        </div>
                    </div>
                </div>
                <div class="best-sellers-slide">
                </div>
                <div class="sort-container">
                    <div class="search-container">
                        <input class='search-input' id="shop-search-input" type="text" placeholder='Search AnyHDD' />
                        <Button class='custom-button common-styles search-button' id="shop-search">
                            Search
                            <svg class='search-icon' xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                viewBox="0 0 14 14" fill="none">
                                <path
                                    d="M6.84245 10.7083C9.23424 10.7083 11.1732 8.7694 11.1732 6.3776C11.1732 3.98581 9.23424 2.04688 6.84245 2.04688C4.45065 2.04688 2.51172 3.98581 2.51172 6.3776C2.51172 8.7694 4.45065 10.7083 6.84245 10.7083Z"
                                    stroke="#052F5A" stroke-width="1.08268" stroke-linecap="round"
                                    stroke-linejoin="round" />
                                <path d="M12.2572 11.7923L9.90234 9.4375" stroke="#052F5A" stroke-width="1.08268"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </Button>
                    </div>
                    <div class="sort">
                        <select class='custom-select common-styles' id="shop-sort-select">
                            <option value="default" selected>Sort by:</option>
                            <option value="popularity">Most Popular</option>
                            <option value="priceLowToHigh">Price: Low to High</option>
                            <option value="priceHighToLow">Price: High to Low</option>
                        </select>
                    </div>
                </div>
                <div class="divider-shop"></div>
                <div class="shop">
                    <div class="filters">
                        <div class='filter-head'>
                            <img src="/img/all-categories.svg" alt="Filters Icon" />
                            <h3>
                                Filters
                            </h3>
                        </div>
                        <div class="filter-container">
                        </div>
                    </div>
                    <div class="products-container">
                        <h5>Docking Stations / 33 Item(s) Found</h5>
                        <div class="products">
                        </div>
                        <div class="pagination-container">
                        </div>
                    </div>
                </div>
            </section>

        </div>

        <footer>
            <div class="overlay no-desk">
                <img src="/img/about-home-overlay.webp" alt="Overlay">
            </div>
            <div class="footer-content">
                <div class="no-desk newsletter-container">
                    <h6>Ready to stay in the loop?</h6>
                    <h5>Subscribe to our newsletter and get <br> exclusive updates, deals, and insights — <br>straight
                        to your inbox.</h5>
                    <div class="newsletter">
                        <input class='form-input search-input' id="newsletter-input" type="text"
                            placeholder='Enter Your Email' />
                        <button class="custom-button search-button" id="newsletter-button">
                            <p>Subscribe Now</p>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="9" viewBox="0 0 16 9"
