                            <div>
                                <span class='light-green'>Our Response time</span><br />
                                Mon-Sun 9:00AM-5:00PM EST
                            </div>
                        </li>
                        <li class='footer-contact-item'>
                            <img src="/src/assets/message.svg" alt="Message Icon" />
