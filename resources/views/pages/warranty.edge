@layout.app({title: 'Warranty', customClass: 'inner-pages'})

@slot('styles')
@vite(['resources/css/core/warranty.scss', 'resources/js/core/warranty.js'])
@vite('resources/css/app.css')
<link href="https://cdn.jsdelivr.net/combine/npm/daisyui@5/components/loading.css,npm/daisyui@5/components/alert.css,npm/daisyui@5/theme/light.css" rel="stylesheet" type="text/css" />
@endslot

@slot('main')
<div id="smooth-wrapper">
    <div id="smooth-content">
        <div class="warranty-container">
            <div class="top-spacing"></div>

            <!-- START HERE -->
            <section class="ask_warranty">
                <img class="warranty_images show-in-left" src="/assets/warranty/warranty.webp"
                    alt="warranty images">
                <div class="form_container">
                    <h1 class="section-header xxxxl">AnyHDD<br /> <span>Warranty Policy</span></h1>
                    <p class="xxxs sub-title">We will require the following information</p>
                    <form class="warranty_form"
                        x-data="warrantyForm()"
                        x-ref="warrantyForm"
                        hx-post="{{ route('api.pages.warranty') }}"
                        hx-encoding="multipart/form-data"
                        hx-target="#response-feedback"
                        hx-target-error="#response-feedback"
                        hx-swap="innerHTML"
                        @htmx:before-request="loading = true"
                        @htmx:after-settle="loading = false; resetForm()">

                        <div id="response-feedback"></div>

                        <div class="wrapper-halfs">
                            <div class="input-container-half ">
                                <label for="name">Full Name*</label>
                                <input placeholder="Enter your name" name="name" required type="text">
                            </div>
                            <div class="input-container-half ">
                                <label for="company">Company Name</label>
                                <input placeholder="Enter your company name" name="company" type="text">
                            </div>
                        </div>
                        <div class="wrapper-halfs">
                            <div class="input-container-half ">
                                <label for="email">Email*</label>
                                <input placeholder="Enter your email" name="email" required type="email">
                            </div>
                            <div class="input-container-half ">
                                <label for="phone">Phone Number*</label>
                                <input placeholder="Phone Number" name="phone" required type="tel">
                            </div>
                        </div>
                        <div class="wrapper-halfs">
                            <div class="input-container-half ">
                                <label for="serialNumber">Product Serial Number*</label>
                                <input placeholder="Enter serial number" name="serialNumber" required type="text">
                            </div>
                            <div class="input-container-half ">
                                <label for="sku">Product Part Number (SKU)</label>
                                <input placeholder="Enter SKU" name="sku" type="text">
                            </div>
                        </div>
                        <div class="input-container">
                            <label for="issueDescription">Describe your issue*</label>
                            <textarea placeholder="Describe your issue" name="issueDescription" required type="text"></textarea>
                        </div>
                        <div class="input-container upload-container">
                            <label for="file-upload" style="cursor: pointer;">
                                <img class="upload_icon" src="/assets/warranty/upload_icon.png" alt="upload icon">
                                <div id="upload-text-container">
                                    <template x-if="files.length > 0">
                                        <p>Files(<span x-text="files.length"></span>)</p>
                                    </template>
                                    <template x-if="files.length === 0">
                                        <p>Upload Photos <span>(Not Required)</span></p>
                                    </template>
                                </div>
                            </label>
                            <input
                                id="file-upload"
                                name="images[]"
                                accept="image/jpeg,image/jpg,image/png,image/webp"
                                type="file"
                                multiple
                                @change="handleFiles($event)"
                                style="display: none;">
                        </div>
                        <button class="submit-btn htmx-button" type="submit" :disabled="loading">
                            <span x-show="!loading">Submit</span>
                            <span x-show="loading" class="loading loading-dots loading-md"></span>
                        </button>
                    </form>
                </div>

            </section>
            <!-- END HERE -->
            @include('components/common/footer')
        </div>
    </div>
</div>
@endslot
@end