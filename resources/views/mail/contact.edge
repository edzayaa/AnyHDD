<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Form Submission</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            background-color: #F2F2F4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #FFFFFF;
        }
        .header {
            background-color: #00254B;
            padding: 40px 30px;
            text-align: center;
        }
        .header h1 {
            color: #FFFFFF;
            margin: 0;
            font-size: 32px;
            font-weight: 700;
        }
        .header p {
            color: rgba(248, 248, 248, 0.70);
            margin: 10px 0 0 0;
            font-size: 16px;
        }
        .content {
            padding: 40px 30px;
        }
        .field {
            margin-bottom: 24px;
        }
        .field-label {
            color: #00254B;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }
        .field-value {
            color: #000000;
            font-size: 16px;
            line-height: 1.5;
            padding: 12px;
            background-color: #F2F2F4;
            border-radius: 4px;
        }
        .reason-badge {
            display: inline-block;
            padding: 8px 16px;
            background-color: #00254B;
            color: #FFFFFF;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            text-transform: capitalize;
        }
        .message-box {
            background-color: #F2F2F4;
            padding: 20px;
            border-left: 4px solid #00254B;
            border-radius: 4px;
        }
        .footer {
            background-color: #00254B;
            padding: 30px;
            text-align: center;
        }
        .footer p {
            color: rgba(248, 248, 248, 0.70);
            margin: 0;
            font-size: 14px;
        }
        .divider {
            height: 1px;
            background-color: #E4E4E4;
            margin: 30px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Get in touch with us</h1>
            <p>New contact form submission</p>
        </div>
        
        <div class="content">
            <div class="field">
                <span class="field-label">Name</span>
                <div class="field-value">{{ name }}</div>
            </div>
            
            <div class="field">
                <span class="field-label">Email</span>
                <div class="field-value">{{ email }}</div>
            </div>
            
            <div class="field">
                <span class="field-label">Phone Number</span>
                <div class="field-value">{{ phone }}</div>
            </div>
            
            <div class="field">
                <span class="field-label">Contact Reason</span>
                <div>
                    <span class="reason-badge">{{ reason }}</span>
                </div>
            </div>
            
            <div class="divider"></div>
            
            <div class="field">
                <span class="field-label">Message</span>
                <div class="message-box">
                    {{ message }}
                </div>
            </div>
        </div>
        
        <div class="footer">
            <p>We'd love to hear from you. Whether you need a quote, technical help, or have gear to sell — our team is here to help.</p>
        </div>
    </div>
</body>
</html>
