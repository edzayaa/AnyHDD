<div class="personal-info-section">
    <div class="section-header">
        <h2 class="section-title">Personal Information</h2>
        <button class="edit-btn">Edit</button>
    </div>

    <div class="info-grid">
        <div class="info-field">
            <label class="info-label">Name</label>
            <p class="info-value">{{ customer.firstName ? customer.firstName : 'N/A' }}</p>
        </div>

        <div class="info-field">
            <label class="info-label">Last Name</label>
            <p class="info-value">{{ customer.lastName ? customer.lastName : 'N/A' }}</p>
        </div>

        <div class="info-field">
            <label class="info-label">Email</label>
            <p class="info-value">{{ customer.email }}</p>
        </div>

        <div class="info-field">
            <label class="info-label">Phone Number</label>
            <p class="info-value">{{ customer.phoneNumber ? customer.phoneNumber : 'N/A' }}</p>
        </div>

        <div class="info-field">
            <label class="info-label">Password</label>
            <div class="password-field">
                <input type="password" readonly value="********" class="info-value">
            </div>
        </div>
    </div>
</div>