<div role="alert" class="tw-alert tw-alert-success" style="padding: 1rem !important; margin-bottom: 1rem !important;">
    <svg xmlns="http://www.w3.org/2000/svg" class="tw-h-6 tw-w-6 tw-shrink-0 tw-stroke-current tw-stroke-white" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="tw-text-white">{{ message}}</span>
</div>