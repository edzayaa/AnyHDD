<div  x-cloak x-data="{ showError: false, showSuccess: false, message: '', title: '', scope: '{{ scope || 'global' }}' }"
    @app:error.window="
        if ($event.detail.scope === scope) {
            message = $event.detail.message;
            title = $event.detail.title || 'Error';
            showError = true;
            setTimeout(() => showError = false, 5000);
        }
    "
    @app:success.window="
        if ($event.detail.scope === scope) {
            message = $event.detail.message;
            title = $event.detail.title || 'Success';
            showSuccess = true;
            setTimeout(() => showSuccess = false, 5000);
        }
    ">
    
    @include('components/feedback/shared/toast/_error')
    @include('components/feedback/shared/toast/_success')
    
</div>